{
  "name": "tomis",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "description": "TOMIS — The Half-Collar Shirt. Digital flagship store.",
  "scripts": {
    "dev": "cd apps/storefront && pnpm run dev",
    "build": "cd apps/storefront && pnpm run build",
    "start": "cd apps/storefront && pnpm run start",
    "lint": "cd apps/storefront && pnpm run lint",
    "typecheck": "cd apps/storefront && pnpm exec tsc --noEmit",
    "db:generate": "cd packages/database && pnpm run db:generate",
    "db:migrate": "cd packages/database && pnpm run db:migrate",
    "db:push": "cd packages/database && pnpm run db:push",
    "db:studio": "cd packages/database && pnpm run db:studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
